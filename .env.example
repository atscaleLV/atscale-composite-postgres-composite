# Optional Compose overrides. The defaults preserve the original lab names.
# Copy this file to .env only when a default conflicts with another local lab.
COMPOSITE_PROJECT_NAME=atscale-composite-lab
COMPOSITE_PG_CONTAINER_NAME=atscale-composite-postgres
COMPOSITE_PG_VOLUME=atscale-composite-pg-data

# PostgreSQL remains bound to host loopback unless this is deliberately changed.
COMPOSITE_PG_BIND=127.0.0.1
COMPOSITE_PG_PORT=54329
